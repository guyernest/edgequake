# EdgeQuake WebUI Environment Configuration
# Copy this file to .env.local and update the values

# API Configuration
# The base URL for the EdgeQuake API server
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: Default tenant ID for multi-tenant deployments
# NEXT_PUBLIC_DEFAULT_TENANT_ID=default

# Optional: Feature flags
# NEXT_PUBLIC_ENABLE_DEMO_MODE=true
# NEXT_PUBLIC_ENABLE_API_EXPLORER=true

# Backend transport type — controls real-time pipeline-progress transport.
# OPTIONAL. Default (unset or any value other than 'lambda'): self-hosted mode,
# WebSocket transport is active for real-time ingestion progress updates.
# Set to 'lambda' to disable the WebSocket and use the polling transport instead
# (GET /api/v1/documents/track/{track_id} every 2s via useQuery). Use this for
# the Lambda-deployed backend (pmcp.run embedding) where persistent WebSocket
# connections cannot survive Lambda invocation semantics.
#
# IMPORTANT (Next.js NEXT_PUBLIC_* build-time inlining): because Next.js inlines
# NEXT_PUBLIC_* variables at BUILD time (not runtime), this variable must be
# present in the BUILD environment for the Lambda-deployed (apps/graph-rag-admin)
# Amplify Hosting app. Set it as an Amplify Console environment variable before
# triggering a build — runtime-only injection has no effect on the client bundle.
#
# NEXT_PUBLIC_BACKEND_TYPE=lambda
